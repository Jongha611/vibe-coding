{
  "description": "TDD 훅 — 소스 편집 전 테스트 선행을 확인(PreToolUse)하고, 편집 후 테스트를 돌려 Red/Green 을 기록한다(PostToolUse)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tdd_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: 테스트 선행 확인 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/tdd_pytest.py\"",
            "timeout": 120,
            "statusMessage": "TDD: 테스트 실행 중..."
          }
        ]
      }
    ]
  }
}
